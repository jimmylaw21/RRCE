    "learning_rate": 0.01,
    "weight_decay": 0.1,
    "betas": [
      0.9,
      0.999
    ],
    "epsilon": 1e-08,
    "timesteps": [
      10,
      30,
      50,
      70,
      90,
      110,
      130,
      150,
      170,
      190,
      210,
      230,
      250,
      270,
      290,
      310,
      330,
      350,
      370,
      390,
      410,
      430,
      450,
      470,
      490,
      510,
      530,
      550,
      570,
      590,
      610,
      630,
      650,
      670,
      690,
      710,
      730,
      750,
      770,
      790,
      810,
      830,
      850,
      870,
      890,
      910,
      930,
      950,
      970,
      990
    ],
    "iterations_per_timestep": 40,
    "projection_iterations": 32,
    "sampling": {
      "scheduler": "ddim",
      "precision": "fp16",
      "steps": 50,
      "guidance_scale": 7.5,
      "batch_size": 1
    }
  },
  "protocol": {
    "seed_namespace": "aaai2027-eval-v2",
    "explicit_threshold": 0.5,
    "nudity_erased_prompts": 88,
    "nudity_erased_repeats": 5,
    "nudity_attack_prompts": 95,
    "coco_labels_file": "protocol/coco_labels.json",
    "ud_prompts_file": "protocol/dog_ud.json"
  }
}
