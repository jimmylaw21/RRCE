    "target_images": "data/van_gogh/target",
    "retain_manifest": "data/van_gogh/retain/retain.csv",
    "gallery_manifest": "data/van_gogh/gallery/gallery.csv"
  },
  "training": {
    "output": "outputs/van_gogh/train",
